# Production environment for the single-droplet stack.
#
#   cp deploy/.env.example deploy/.env   &&   chmod 600 deploy/.env
#
# deploy/.env is gitignored and must stay that way: it holds live secrets.
# Every value marked REQUIRED has no usable default.

# ---------------------------------------------------------------- database ----
# Used by the postgres container AND composed into DATABASE_URL. The app never
# talks to any host but the postgres service on the compose network.
POSTGRES_DB=reconciliation
POSTGRES_USER=reconciliation              # REQUIRED
POSTGRES_PASSWORD=                        # REQUIRED - generate: openssl rand -base64 32

# ------------------------------------------------------------------- public ----
# REQUIRED. What Caddy serves:
#   a hostname (HTTPS with a Let's Encrypt certificate; needs an A record pointing at
#   this droplet before the first start), or
#   http://<droplet IP> (plain HTTP, no certificate) when there is no DNS name.
DOMAIN=reconciliation.example.com
#DOMAIN=http://203.0.113.10
ACME_EMAIL=you@example.com                # REQUIRED by compose; used only for a hostname

# ------------------------------------------------------------------- sizing ----
# Tuned for a 2 vCPU / 4 GB droplet. Raise on bigger hosts.
PROCESSING_MAX_CONCURRENT_IMPORTS=1
PROCESSING_BATCH_SIZE=1000
PROCESSING_MAX_IN_FLIGHT_BATCHES=2
RISK_WORKER_THREADS=0                     # 0 = number of CPUs
UPLOAD_MAX_CONCURRENT=4
UPLOAD_MAX_FILE_SIZE_BYTES=209715200      # 200 MB
KAFKA_IMPORTS_PARTITIONS=8

# ------------------------------------------------------------------ data ----
# Host directory holding postgres/, kafka/ and uploads/. Plain directories, not Docker
# volumes: no docker command can delete them. Change only before the first start.
#DATA_DIR=/var/lib/reconciliation

# ---------------------------------------------------------------- optional ----
# All off by default. See README.md -> Configuration and ARCHITECTURE.md -> Optional features.
#UPLOAD_PROVIDER_RATE_LIMIT=60           # uploads per provider per UPLOAD_PROVIDER_RATE_WINDOW (1m)
#RETENTION_ENABLED=true                  # delete uploaded files of imports terminal for 7d
#API_KEYS_ENABLED=true                   # require Authorization: Bearer <key> on /v1
#API_KEYS=<sha256-hex-of-key>:<providerId>,...   # hashes only, never the keys
#MANAGEMENT_OTLP_TRACING_ENDPOINT=http://<collector>:4318/v1/traces
