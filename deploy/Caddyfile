# Reverse proxy (and TLS, when DOMAIN is a hostname) for the reconciliation API.
#
# DOMAIN is substituted before parsing, so it decides the mode:
#   DOMAIN=api.example.com         Caddy obtains and renews a Let's Encrypt certificate and
#                                  redirects http -> https. The name must resolve to this
#                                  droplet before the first start, or the ACME challenge fails.
#   DOMAIN=http://165.245.247.93   plain HTTP on port 80 for a bare IP: no certificate, no
#                                  redirect. Let's Encrypt does not issue certificates for a
#                                  bare IP here, and clients send no SNI for one.

{
	# Certificate expiry and renewal failures arrive here.
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	# Compress everything except server-sent events: a compressing encoder buffers output,
	# which would hold progress events back instead of passing each one through at once.
	@compressible not path /v1/imports/*/events
	encode @compressible zstd gzip

	reverse_proxy api:8080 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {remote_host}
		header_up Host {host}
		# A 200 MB upload on a slow link takes a while; keep the backend stream open.
		transport http {
			read_timeout 10m
			write_timeout 10m
		}
	}

	# Mirrors app.upload.max-file-size-bytes plus multipart overhead; Caddy rejects
	# larger bodies before they reach the JVM.
	request_body {
		max_size 210MB
	}

	log {
		output file /data/access.log {
			roll_size 20MB
			roll_keep 5
		}
	}
}
